{
  "windows_dev_agent": {
    "command": "powershell.exe",
    "args": [
      "-NoProfile",
      "-NonInteractive",
      "-ExecutionPolicy",
      "Bypass",
      "-File",
      "scripts/launch-python.ps1",
      "-Module",
      "src.codex_server"
    ],
    "cwd": ".",
    "env": {"WINDOWS_DEV_AGENT_HOST": "codex"},
    "tool_timeout_sec": 610,
    "default_tools_approval_mode": "prompt",
    "tools": {
      "env_inspect": {"approval_mode": "approve"},
      "tool_discover": {"approval_mode": "prompt"},
      "workflow_plan": {"approval_mode": "prompt"},
      "package_search": {"approval_mode": "prompt"},
      "logs_query": {"approval_mode": "approve"},
      "ecosystem_scan": {"approval_mode": "prompt"},
      "mcp_audit": {"approval_mode": "prompt"},
      "capability_run": {"approval_mode": "prompt"},
      "package_install": {"approval_mode": "prompt"},
      "sandbox_run": {"approval_mode": "prompt"}
    }
  }
}
