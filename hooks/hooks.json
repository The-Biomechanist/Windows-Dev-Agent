{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__windows-dev-agent__capability_run|mcp__windows-dev-agent__package_install|mcp__windows-dev-agent__sandbox_run",
        "hooks": [
          {
            "type": "command",
            "command": "python -m src.safety.gate",
            "description": "Classify the requested action and allow, ask, or deny through Claude Code's host permission surface"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python -m src.observability.trace",
            "description": "Append a redacted structured success event to the session audit log"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python -m src.observability.trace",
            "description": "Append a redacted structured failure event to the session audit log"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python -m src.observability.audit_report",
            "description": "Print a concise end-of-session audit summary"
          }
        ]
      }
    ]
  }
}
