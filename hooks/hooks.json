{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|PowerShell|mcp__(windows-dev-agent|plugin_windows-dev-agent_windows-dev-agent)__(capability_run|package_install|sandbox_run))$",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/src/safety/gate.py\" --data-dir \"${CLAUDE_PLUGIN_DATA}\"",
            "description": "Classify the effective requested action and allow, ask, or deny through Claude Code's host permission surface"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^mcp__(windows-dev-agent|plugin_windows-dev-agent_windows-dev-agent)__.*$",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/src/observability/trace.py\" --data-dir \"${CLAUDE_PLUGIN_DATA}\"",
            "description": "Append minimal metadata for successful Windows Dev Agent MCP calls to the persistent audit log"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "^mcp__(windows-dev-agent|plugin_windows-dev-agent_windows-dev-agent)__.*$",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/src/observability/trace.py\" --data-dir \"${CLAUDE_PLUGIN_DATA}\"",
            "description": "Append minimal metadata for failed Windows Dev Agent MCP calls to the persistent audit log"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/src/observability/audit_report.py\" --data-dir \"${CLAUDE_PLUGIN_DATA}\"",
            "description": "Print an audit summary bound to the current Claude session"
          }
        ]
      }
    ]
  }
}
