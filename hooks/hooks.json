{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|PowerShell|mcp__(windows-dev-agent|plugin_windows-dev-agent_windows-dev-agent)__(tool_discover|package_search|capability_run|package_install|sandbox_run|ecosystem_scan|mcp_audit))$",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/src/safety/gate.py\" --data-dir \"${CLAUDE_PLUGIN_DATA}\"",
            "description": "Tighten Claude Code's normal permission flow for external execution, mutations, forbidden actions, and broader read scopes"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^mcp__(windows-dev-agent|plugin_windows-dev-agent_windows-dev-agent)__.*$",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/src/observability/trace.py\" --data-dir \"${CLAUDE_PLUGIN_DATA}\"",
            "description": "Append minimal derived metadata for completed Windows Dev Agent MCP calls"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "^mcp__(windows-dev-agent|plugin_windows-dev-agent_windows-dev-agent)__.*$",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/src/observability/trace.py\" --data-dir \"${CLAUDE_PLUGIN_DATA}\"",
            "description": "Append minimal derived metadata for failed Windows Dev Agent MCP calls"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/src/observability/audit_report.py\" --data-dir \"${CLAUDE_PLUGIN_DATA}\"",
            "description": "Print a session-bound Windows Dev Agent audit summary"
          }
        ]
      }
    ]
  }
}