{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|PowerShell|mcp__(windows-dev-agent|plugin_windows-dev-agent_windows-dev-agent)__(tool_discover|package_search|capability_run|package_install|sandbox_run|ecosystem_scan|mcp_audit))$",
        "hooks": [
          {
            "type": "command",
            "command": "${SystemRoot}\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
            "args": ["-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass", "-File", "${CLAUDE_PLUGIN_ROOT}/scripts/launch-python.ps1", "-Module", "src.safety.claude_gate", "--data-dir", "${CLAUDE_PLUGIN_DATA}"],
            "description": "Tighten Claude Code's normal permission flow for external execution, mutations, forbidden actions, and broader read scopes"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^mcp__(windows-dev-agent|plugin_windows-dev-agent_windows-dev-agent)__.*$",
        "hooks": [
          {
            "type": "command",
            "command": "${SystemRoot}\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
            "args": ["-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass", "-File", "${CLAUDE_PLUGIN_ROOT}/scripts/launch-python.ps1", "-Module", "src.observability.trace", "--data-dir", "${CLAUDE_PLUGIN_DATA}"],
            "description": "Append minimal derived metadata for completed Windows Dev Agent MCP calls"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "^mcp__(windows-dev-agent|plugin_windows-dev-agent_windows-dev-agent)__.*$",
        "hooks": [
          {
            "type": "command",
            "command": "${SystemRoot}\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
            "args": ["-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass", "-File", "${CLAUDE_PLUGIN_ROOT}/scripts/launch-python.ps1", "-Module", "src.observability.trace", "--data-dir", "${CLAUDE_PLUGIN_DATA}"],
            "description": "Append minimal derived metadata for failed Windows Dev Agent MCP calls"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${SystemRoot}\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
            "args": ["-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass", "-File", "${CLAUDE_PLUGIN_ROOT}/scripts/launch-python.ps1", "-Module", "src.observability.audit_report", "--data-dir", "${CLAUDE_PLUGIN_DATA}"],
            "description": "Print a session-bound Windows Dev Agent audit summary"
          }
        ]
      }
    ]
  }
}
