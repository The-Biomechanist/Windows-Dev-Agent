{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__windows-dev-agent__capability_run|mcp__windows-dev-agent__package_install|mcp__windows-dev-agent__sandbox_run",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/src/safety/gate.py\" --data-dir \"${CLAUDE_PLUGIN_DATA}\"",
            "description": "Classify the requested action and allow, ask, or deny through Claude Code's host permission surface"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/src/observability/trace.py\" --data-dir \"${CLAUDE_PLUGIN_DATA}\"",
            "description": "Append a redacted structured success event to the persistent plugin audit log"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/src/observability/trace.py\" --data-dir \"${CLAUDE_PLUGIN_DATA}\"",
            "description": "Append a redacted structured failure event to the persistent plugin audit log"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/src/observability/audit_report.py\" --data-dir \"${CLAUDE_PLUGIN_DATA}\"",
            "description": "Print a concise end-of-session audit summary"
          }
        ]
      }
    ]
  }
}
