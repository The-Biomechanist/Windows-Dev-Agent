{
  "description": "Codex host hooks for Windows Dev Agent. Native Codex policy remains authoritative; trusted hooks deny forbidden actions and auto-approve only plan-first non-executing MCP calls.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|mcp__windows_dev_agent__(capability_run|package_install|sandbox_run))$",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/src/safety/codex_gate.py\"",
            "commandWindows": "python \"${PLUGIN_ROOT}/src/safety/codex_gate.py\"",
            "timeout": 30,
            "description": "Deny forbidden Windows Dev Agent actions and otherwise defer to Codex permissions"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "^mcp__windows_dev_agent__(capability_run|package_install|sandbox_run)$",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/src/safety/codex_permission.py\"",
            "commandWindows": "python \"${PLUGIN_ROOT}/src/safety/codex_permission.py\"",
            "timeout": 30,
            "description": "Allow only plan-first execute=false calls; defer execution and filesystem inventory reads to Codex approval"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^mcp__windows_dev_agent__.*$",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/src/observability/codex_trace.py\"",
            "commandWindows": "python \"${PLUGIN_ROOT}/src/observability/codex_trace.py\"",
            "timeout": 30,
            "description": "Append minimal derived Windows Dev Agent completion metadata"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/src/observability/codex_audit_report.py\"",
            "commandWindows": "python \"${PLUGIN_ROOT}/src/observability/codex_audit_report.py\"",
            "timeout": 30,
            "description": "Emit a Codex-valid Windows Dev Agent session audit summary with explicit unknown outcomes"
          }
        ]
      }
    ]
  }
}
