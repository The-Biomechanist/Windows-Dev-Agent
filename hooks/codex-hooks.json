{
  "description": "Codex host hooks for Windows Dev Agent. Native Codex policy remains authoritative; trusted hooks deny forbidden actions and auto-approve only narrowly safe plan calls whose scope is established from the hook event.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|mcp__windows_dev_agent__(capability_run|package_install|sandbox_run))$",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command $p=Join-Path $env:PLUGIN_ROOT 'scripts\\launch-python.ps1';^& $p -Module src.safety.codex_gate",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command $p=Join-Path $env:PLUGIN_ROOT 'scripts\\launch-python.ps1';^& $p -Module src.safety.codex_gate",
            "timeout": 30,
            "description": "Deny forbidden Windows Dev Agent actions and otherwise defer to Codex permissions"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "^mcp__windows_dev_agent__(capability_run|workflow_plan|package_install)$",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command $p=Join-Path $env:PLUGIN_ROOT 'scripts\\launch-python.ps1';^& $p -Module src.safety.codex_permission",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command $p=Join-Path $env:PLUGIN_ROOT 'scripts\\launch-python.ps1';^& $p -Module src.safety.codex_permission",
            "timeout": 30,
            "description": "Auto-allow only bounded plan calls; project plans must stay inside the authoritative Codex session cwd"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^mcp__windows_dev_agent__.*$",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command $p=Join-Path $env:PLUGIN_ROOT 'scripts\\launch-python.ps1';^& $p -Module src.observability.codex_trace",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command $p=Join-Path $env:PLUGIN_ROOT 'scripts\\launch-python.ps1';^& $p -Module src.observability.codex_trace",
            "timeout": 30,
            "description": "Append minimal derived Windows Dev Agent completion metadata"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command $p=Join-Path $env:PLUGIN_ROOT 'scripts\\launch-python.ps1';^& $p -Module src.observability.codex_audit_report",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command $p=Join-Path $env:PLUGIN_ROOT 'scripts\\launch-python.ps1';^& $p -Module src.observability.codex_audit_report",
            "timeout": 30,
            "description": "Emit a Codex-valid Windows Dev Agent session audit summary with explicit unknown outcomes"
          }
        ]
      }
    ]
  }
}
